generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String
  role         Role         @default(SALES_USER)
  enquiries    Enquiry[]
  quotations   Quotation[]
  salesOrders  SalesOrder[]
  dispatches   Dispatch[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Customer {
  id            Int          @id @default(autoincrement())
  companyName   String
  contactPerson String
  mobile        String
  email         String
  city          String
  enquiries     Enquiry[]
  quotations    Quotation[]
  salesOrders   SalesOrder[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Product {
  id              Int              @id @default(autoincrement())
  productCode     String           @unique
  productName     String
  category        String
  unit            String
  basePrice       Float
  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Inventory {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id])
  enquiryDate   DateTime      @default(now())
  requiredDate  DateTime?
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdById   Int
  createdBy     User          @relation(fields: [createdById], references: [id])
  items         EnquiryItem[]
  quotations    Quotation[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model EnquiryItem {
  id        Int     @id @default(autoincrement())
  enquiryId Int
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique
  enquiryId       Int
  enquiry         Enquiry         @relation(fields: [enquiryId], references: [id])
  customerId      Int
  customer        Customer        @relation(fields: [customerId], references: [id])
  validUntil      DateTime?
  status          QuotationStatus @default(DRAFT)
  totalAmount     Float           @default(0.0)
  createdById     Int
  createdBy       User            @relation(fields: [createdById], references: [id])
  items           QuotationItem[]
  salesOrder      SalesOrder?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model QuotationItem {
  id              Int       @id @default(autoincrement())
  quotationId     Int
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Float
  discountPercent Float     @default(0.0)
  gstPercent      Float     @default(18.0)
  lineAmount      Float
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNumber String           @unique
  quotationId Int              @unique
  quotation   Quotation        @relation(fields: [quotationId], references: [id])
  customerId  Int
  customer    Customer         @relation(fields: [customerId], references: [id])
  orderDate   DateTime         @default(now())
  totalAmount Float
  status      SalesOrderStatus @default(PENDING)
  createdById Int
  createdBy   User             @relation(fields: [createdById], references: [id])
  items       SalesOrderItem[]
  dispatches  Dispatch[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    Int
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPrice    Float
}

model Dispatch {
  id             Int            @id @default(autoincrement())
  dispatchNumber String         @unique
  salesOrderId   Int
  salesOrder     SalesOrder     @relation(fields: [salesOrderId], references: [id])
  dispatchDate   DateTime       @default(now())
  vehicleNumber  String
  driverName     String
  createdById    Int
  createdBy      User           @relation(fields: [createdById], references: [id])
  items          DispatchItem[]
  createdAt      DateTime       @default(now())
}

model DispatchItem {
  id         Int      @id @default(autoincrement())
  dispatchId Int
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
}
