# ============================================================
# UDYAM ERP — Production Environment Variables
# Copy this to .env and update values for your environment
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Use your hosted PostgreSQL URL)
# For local Docker: postgresql://udyam_user:udyam_password@localhost:5432/udyam_db?schema=public
# For Render/Railway: Use the provided Internal Database URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# JWT Authentication
# IMPORTANT: Change this to a strong, unique secret in production!
JWT_SECRET="your_production_jwt_secret_here_change_this"
JWT_EXPIRES_IN="7d"
