# ==============================================================================
# UDYAM ERP SERVER — ENVIRONMENT CONFIGURATION (NEON + VERCEL)
# ==============================================================================

PORT=5000
NODE_ENV=production

# NEON POSTGRESQL CONNECTION STRINGS
# Runtime pooled connection (recommended for Vercel / serverless):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection (for schema migrations):
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# AUTHENTICATION
JWT_SECRET="udyam_super_secret_production_jwt_key_2026_change_in_prod"
JWT_EXPIRES_IN="7d"
CLIENT_URL="https://your-udyam-app.vercel.app"
