# ==============================================================================
# UDYAM ERP — ENVIRONMENT CONFIGURATION (NEON + VERCEL)
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# NEON POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Use Neon Pooled connection string (with -pooler) for serverless runtime queries
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Use Neon Direct unpooled connection string for migrations (prisma db push)
DIRECT_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET="udyam_super_secret_production_jwt_key_2026_change_in_prod"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# CLIENT CORS (Optional if deployed fullstack on Vercel)
# ------------------------------------------------------------------------------
CLIENT_URL="https://your-udyam-app.vercel.app"
